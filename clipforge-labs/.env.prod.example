# =========================
# Clipforge Labs production env
# =========================

# Core
APP_ENV=production
SECRET_KEY=
COOKIE_DOMAIN=.clipforge.us
FRONTEND_ORIGIN=https://clipforge.us
FRONTEND_BASE_URL=https://clipforge.us
PUBLIC_API_BASE=https://api.clipforge.us
# Canonical web host used by frontend metadata/robots/sitemap.
SITE_URL=https://clipforge.us
# Optional hard redirect of all frontend host variants -> this host.
# Example: CANONICAL_HOST=clipforge.us
CANONICAL_HOST=

# Frontend build/runtime (not secret)
NEXT_PUBLIC_API_BASE=https://api.clipforge.us

# Database
# Recommended: RDS Postgres (example):
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=sqlite:////data/app.db

# Storage
STORAGE_BACKEND=s3
LOCAL_STORAGE_PATH=/data/storage
# For GCS (S3-compatible) use: AWS_REGION=auto, S3_ENDPOINT_URL=https://storage.googleapis.com, S3_ADDRESSING_STYLE=path
AWS_REGION=auto
S3_BUCKET=
S3_ENDPOINT_URL=https://storage.googleapis.com
S3_ADDRESSING_STYLE=path
S3_SIGNATURE_VERSION=s3v4
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Social posting dispatcher (set to 1 after providers are approved/configured)
SOCIAL_DISPATCH_ENABLED=0

# Generation economics / guardrails
# 1 credit = this USD value
LABS_CREDIT_USD_VALUE=0.10

# Video pricing model:
# user price credits/sec = ceil((provider_cost_usd_per_sec * markup) / LABS_CREDIT_USD_VALUE)
LABS_VIDEO_REAL_USD_PER_SECOND=0.50
LABS_VIDEO_LOW_COST_USD_PER_SECOND=0.10
LABS_VIDEO_HD_MARKUP=2.7
LABS_VIDEO_4K_MARKUP=3.0

# Optional explicit overrides (if set, these override formula output):
# LABS_VIDEO_REAL_HD_CREDITS_PER_SECOND=
# LABS_VIDEO_REAL_4K_CREDITS_PER_SECOND=
# LABS_VIDEO_LOW_COST_HD_CREDITS_PER_SECOND=
# LABS_VIDEO_LOW_COST_4K_CREDITS_PER_SECOND=

# Image pricing model:
# user price credits/image = ceil((provider_cost_usd_per_image * LABS_IMAGE_MARKUP) / LABS_CREDIT_USD_VALUE)
LABS_IMAGE_REAL_USD_PER_IMAGE=0.04
LABS_IMAGE_LOW_COST_USD_PER_IMAGE=0.02
LABS_IMAGE_MARKUP=6.0

# Optional explicit overrides:
# LABS_IMAGE_REAL_CREDITS=
# LABS_IMAGE_LOW_COST_CREDITS=

# Voiceover pricing model: 1 credit per N words.
LABS_VOICE_WORDS_PER_CREDIT=300
LABS_VOICE_MIN_CREDITS=1
# Optional: stylized AI Post (anime/cartoon/comic) video+voice credits/sec override.
# LABS_POST_LOW_COST_VIDEO_CREDITS_PER_SECOND=

# Generation provider wiring
# Default keeps local placeholder generation enabled.
LABS_GENERATION_PROVIDER=stub
# When strict mode is enabled, provider failures fail jobs instead of falling back to placeholders.
LABS_GENERATION_STRICT=0
# Enables local placeholder fallback when provider calls fail due capacity.
LABS_ALLOW_DEMO_FALLBACK=0
LABS_ALLOW_PLACEHOLDER_POST_OUTPUT=0
LABS_POST_VOICE_CAPACITY_RETRIES=2
LABS_POST_VOICE_CAPACITY_BACKOFF_SECONDS=6
LABS_POST_SCENE_CAPACITY_RETRIES=2
LABS_POST_SCENE_CAPACITY_BACKOFF_SECONDS=6
LABS_POST_ATTEMPT_COOLDOWN_SECONDS=8
LABS_POST_USE_SCENE_REUSE_ON_CAPACITY=1
GOOGLE_API_KEY=
GOOGLE_API_BEARER_TOKEN=
GOOGLE_X_API_KEY=
GOOGLE_VERTEX_PROJECT_ID=
GOOGLE_VERTEX_LOCATION=us-central1
GOOGLE_VIDEO_MODEL_ID=veo-2.0-generate-001
GOOGLE_IMAGE_MODEL_ID=imagen-3.0-generate-002
GOOGLE_VIDEO_MAX_DURATION_SECONDS=12
# Cost optimization:
# For stylized presets (anime/cartoon/comic), route to lower-cost models when available.
GOOGLE_USE_LOW_COST_MODELS_FOR_STYLIZED=1
GOOGLE_IMAGE_LOW_COST_MODEL_ID=imagen-4.0-fast-generate-001
GOOGLE_VIDEO_LOW_COST_MODEL_ID=veo-3.1-fast-generate-001
# Optional aliases for low-cost defaults.
GOOGLE_IMAGE_FAST_MODEL_ID=imagen-4.0-fast-generate-001
GOOGLE_VIDEO_FAST_MODEL_ID=veo-3.1-fast-generate-001
# Optional style/task-specific overrides (leave blank to use defaults above):
# GOOGLE_IMAGE_MODEL_ID_REAL=
# GOOGLE_IMAGE_MODEL_ID_ANIME=imagen-4.0-fast-generate-001
# GOOGLE_IMAGE_MODEL_ID_CARTOON=imagen-4.0-fast-generate-001
# GOOGLE_IMAGE_MODEL_ID_COMIC=imagen-4.0-fast-generate-001
# GOOGLE_POST_IMAGE_MODEL_ID=
# GOOGLE_POST_IMAGE_MODEL_ID_ANIME=
# GOOGLE_POST_IMAGE_MODEL_ID_CARTOON=
# GOOGLE_POST_IMAGE_MODEL_ID_COMIC=
# GOOGLE_VIDEO_MODEL_ID_REAL=
# GOOGLE_VIDEO_MODEL_ID_ANIME=veo-3.1-fast-generate-001
# GOOGLE_VIDEO_MODEL_ID_CARTOON=veo-3.1-fast-generate-001
# GOOGLE_VIDEO_MODEL_ID_COMIC=veo-3.1-fast-generate-001
GOOGLE_VIDEO_OUTPUT_GCS_URI=
GOOGLE_VIDEO_TIMEOUT_SECONDS=420
GOOGLE_VIDEO_POLL_SECONDS=8
GOOGLE_VIDEO_ENHANCE_PROMPT=1
GOOGLE_APPEND_API_KEY=0
GOOGLE_API_TIMEOUT_SECONDS=120
# Optional: your Google/Vertex image generation gateway endpoint
# Response should include either:
# - data_base64 + content_type
# - or url + content_type
GOOGLE_IMAGE_API_URL=
# Optional: your Google/Vertex video generation gateway endpoint
GOOGLE_VIDEO_API_URL=
# Google Cloud Text-to-Speech endpoint (supports {API_KEY} placeholder)
GOOGLE_TTS_API_URL=https://texttospeech.googleapis.com/v1/text:synthesize?key={API_KEY}
GOOGLE_TTS_LANGUAGE_CODE=en-US
GOOGLE_TTS_DEFAULT_VOICE=en-US-Neural2-F
GOOGLE_TTS_FALLBACK_VOICE=en-US-Neural2-J
GOOGLE_TTS_USE_SSML=1
GOOGLE_TTS_SENTENCE_BREAK_MS=220
GOOGLE_TTS_PHRASE_BREAK_MS=130
GOOGLE_TTS_PITCH=1.6
GOOGLE_TTS_VOLUME_GAIN_DB=1.5

# OAuth (login + social connections)
OAUTH_ENABLED_PROVIDERS=google
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

OAUTH_TIKTOK_CLIENT_ID=
OAUTH_TIKTOK_CLIENT_SECRET=

OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=
OAUTH_FACEBOOK_CONFIG_ID=
OAUTH_FACEBOOK_USE_CONFIG_ID=0

OAUTH_INSTAGRAM_CLIENT_ID=
OAUTH_INSTAGRAM_CLIENT_SECRET=
OAUTH_INSTAGRAM_CONFIG_ID=

# Meta scope behavior:
OAUTH_META_REQUEST_PUBLISH_SCOPES=0

# Autopost provider allowlist (keep conservative until approved)
AUTOPOST_PROVIDERS=youtube,tiktok,instagram,facebook

# Worker lane tuning
WORKER_RELAX_PREP_DELAY_SECONDS=4
WORKER_FAST_PREP_DELAY_SECONDS=0

# Transactional email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=1
SMTP_USE_SSL=0

EMAIL_AUTOMATIONS_ENABLED=1
EMAIL_FROM_NAME=Clipforge Labs
EMAIL_FROM_EMAIL=no-reply@clipforge.ai
EMAIL_REPLY_TO=support@clipforge.ai
EMAIL_LOGO_URL=https://clipforge.us/clipforge-labs-mark.svg
EMAIL_SEND_WELCOME=1

CONTACT_TO_EMAIL=support@clipforge.ai
