# =========================
# Orbito production env
# =========================

# Core
APP_ENV=production
SECRET_KEY=
COOKIE_DOMAIN=.orbito.cc
# Use the actual host users load your frontend from.
# If you redirect orbito.cc -> app.orbito.cc, set these to app.orbito.cc.
FRONTEND_ORIGIN=https://app.orbito.cc
FRONTEND_BASE_URL=https://app.orbito.cc
PUBLIC_API_BASE=https://api.orbito.cc

# Frontend build/runtime (not secret)
NEXT_PUBLIC_API_BASE=https://api.orbito.cc

# Database
# Recommended: RDS Postgres (example):
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME
#
# Temporary single-box fallback (not recommended long-term):
DATABASE_URL=sqlite:////data/app.db

# Storage
# Recommended: S3 (set STORAGE_BACKEND=s3 and fill S3_BUCKET).
# Temporary local fallback:
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/data/storage
AWS_REGION=us-east-1
S3_BUCKET=

# Feature flags
ENABLE_YOUTUBE_INGEST=0
# Background social post dispatcher (set to 1 only after providers are approved/configured)
SOCIAL_DISPATCH_ENABLED=0

# Automations (recommended: set in prod; required if you want to protect /automations/trigger)
AUTOMATION_WEBHOOK_SECRET=

# Stripe (optional unless billing is live)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FREE_MONTHLY=price_1Stiem7Gixo4GiFWKbg8Aj8S
STRIPE_PRICE_STARTER_MONTHLY=price_1SthkW7Gixo4GiFWPqBRDlrt
STRIPE_PRICE_CREATOR_MONTHLY=price_1SthhG7Gixo4GiFWpyu5YfTh
STRIPE_PRICE_CREATOR_YEARLY=price_1SthiT7Gixo4GiFWH1BsU8om
STRIPE_PRICE_STUDIO_MONTHLY=price_1Sthma7Gixo4GiFWr9C0K2h3

# SMTP (optional; required if /contact/send must work)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=1
SMTP_USE_SSL=0
CONTACT_TO_EMAIL=support@orbito.cc
CONTACT_FROM_EMAIL=

# OAuth (optional)
OAUTH_ENABLED_PROVIDERS=google
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
YOUTUBE_API_KEY=

OAUTH_TIKTOK_CLIENT_ID=
OAUTH_TIKTOK_CLIENT_SECRET=

OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=
OAUTH_FACEBOOK_CONFIG_ID=
OAUTH_INSTAGRAM_CLIENT_ID=
OAUTH_INSTAGRAM_CLIENT_SECRET=
OAUTH_INSTAGRAM_CONFIG_ID=

# Meta scope behavior:
# - Keep 0 until Meta advanced access/app review is approved, otherwise connect may hard-fail with "Invalid Scopes".
OAUTH_META_REQUEST_PUBLISH_SCOPES=0
OAUTH_META_USE_CONFIG_ID=0

# Autopost provider allowlist (keep conservative until approved)
AUTOPOST_PROVIDERS=youtube
