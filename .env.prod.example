# =========================
# Orbito production env
# =========================

# Core
APP_ENV=production
SECRET_KEY=
COOKIE_DOMAIN=.orbito.cc
# Use the actual host users load your frontend from.
# If you redirect orbito.cc -> app.orbito.cc, set these to app.orbito.cc.
FRONTEND_ORIGIN=https://app.orbito.cc
FRONTEND_BASE_URL=https://app.orbito.cc
PUBLIC_API_BASE=https://api.orbito.cc

# Frontend build/runtime (not secret)
NEXT_PUBLIC_API_BASE=https://api.orbito.cc

# Database
# Recommended: RDS Postgres (example):
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME
#
# Temporary single-box fallback (not recommended long-term):
DATABASE_URL=sqlite:////data/app.db

# Storage
# Supported backends:
# - local (single box only)
# - s3    (AWS S3)
# - gcs   (Google Cloud Storage via S3-compatible endpoint)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/data/storage
AWS_REGION=us-east-1
S3_BUCKET=
# Optional S3-compatible settings (required for STORAGE_BACKEND=gcs):
# S3_ENDPOINT_URL=https://storage.googleapis.com
# S3_ADDRESSING_STYLE=path
# S3_SIGNATURE_VERSION=s3v4
# For GCS S3-compat, set AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY to HMAC keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Fallback upload proxy chunk size (bytes). Increase for faster large-file proxy uploads.
UPLOAD_PROXY_CHUNK_SIZE=5242880

# Feature flags
ENABLE_YOUTUBE_INGEST=0
# Background social post dispatcher (set to 1 only after providers are approved/configured)
SOCIAL_DISPATCH_ENABLED=0

# Worker clip limits/tuning
# Max clips rendered per job (effective cap)
WORKER_MAX_RENDER_CLIPS_PER_JOB=30
# Upper bound for top-k selection
WORKER_MAX_TOP_K_CLIPS=30
# Base top-k target (0 means use all scored clips, then capped by max values above)
WORKER_TOP_K_CLIPS=0
# Clip duration/count target (example: 10 min source -> roughly 10-15 clips)
WORKER_CLIP_MIN_SECONDS=25
WORKER_CLIP_TARGET_SECONDS=42
WORKER_CLIP_MAX_SECONDS=50
WORKER_MIN_CLIPS_PER_MINUTE=1.2
# Optional speed-over-quality knobs (uncomment to process faster):
# WORKER_WHISPER_MODEL=tiny
# WORKER_REFRAME_SAMPLE_FPS=3.0
# WORKER_REFRAME_MAX_SAMPLE_FPS=5.0

# Automations (recommended: set in prod; required if you want to protect /automations/trigger)
AUTOMATION_WEBHOOK_SECRET=

# Stripe (optional unless billing is live)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FREE_MONTHLY=price_1Stiem7Gixo4GiFWKbg8Aj8S
STRIPE_PRICE_STARTER_MONTHLY=price_1SthkW7Gixo4GiFWPqBRDlrt
STRIPE_PRICE_CREATOR_MONTHLY=price_1SthhG7Gixo4GiFWpyu5YfTh
STRIPE_PRICE_CREATOR_YEARLY=price_1SthiT7Gixo4GiFWH1BsU8om
STRIPE_PRICE_STUDIO_MONTHLY=price_1Sthma7Gixo4GiFWr9C0K2h3

# SMTP (optional; required if /contact/send must work)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=1
SMTP_USE_SSL=0
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Transactional email behavior (automated user notifications)
EMAIL_AUTOMATIONS_ENABLED=1
EMAIL_FROM_NAME=Orbito Team
# Recommended: no-reply mailbox (unmonitored sender)
EMAIL_FROM_EMAIL=no-reply@orbito.cc
# Optional branded logo used in HTML welcome emails
EMAIL_LOGO_URL=https://orbito.cc/orbito-mark.svg
# Replies (if user hits reply) should route to support inbox
EMAIL_REPLY_TO=support@orbito.cc
EMAIL_SEND_WELCOME=1
EMAIL_SEND_BILLING_CONFIRMATION=1
EMAIL_SEND_CONTACT_AUTOREPLY=1

# OAuth (optional)
OAUTH_ENABLED_PROVIDERS=google
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
YOUTUBE_API_KEY=

OAUTH_TIKTOK_CLIENT_ID=
OAUTH_TIKTOK_CLIENT_SECRET=

OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=
# Optional: separate Meta "consumer" app for "Sign in with Facebook".
# Keep `OAUTH_FACEBOOK_CLIENT_ID/SECRET` for publishing connections (Facebook Pages + Instagram Graph)
# and set the login app creds below for user authentication (/auth/oauth/facebook/*).
OAUTH_FACEBOOK_LOGIN_CLIENT_ID=
OAUTH_FACEBOOK_LOGIN_CLIENT_SECRET=
OAUTH_FACEBOOK_CONFIG_ID=
# Keep OFF unless your Meta Login configuration explicitly requires config_id.
OAUTH_FACEBOOK_USE_CONFIG_ID=0
OAUTH_INSTAGRAM_CLIENT_ID=
OAUTH_INSTAGRAM_CLIENT_SECRET=
OAUTH_INSTAGRAM_CONFIG_ID=

# Meta scope behavior:
# - Keep 0 until Meta advanced access/app review is approved, otherwise connect may hard-fail with "Invalid Scopes".
OAUTH_META_REQUEST_PUBLISH_SCOPES=0
OAUTH_META_USE_CONFIG_ID=0

# Autopost provider allowlist (keep conservative until approved)
AUTOPOST_PROVIDERS=youtube
